# ==============================================================================
# Sarkari.online - Production Environment Configuration (.env.example)
# Rename this file to `.env` on your production server.
# ==============================================================================

APP_NAME=Sarkari.online
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sarkari.online
APP_KEY=sarkari_online_secure_production_key_replace_me

# Database Connection (MySQL / MariaDB on Ubuntu/Nginx)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=automation
DB_USERNAME=sarkari_user
DB_PASSWORD=YourStrongDatabasePasswordHere#
DB_CHARSET=utf8mb4

# Gemini AI Engine Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=60
GEMINI_MAX_RETRIES=5

# Publishing & Safety Limits
AUTO_PUBLISH_DAILY_LIMIT=5
MIN_QUALITY_SCORE=85

# Trend Detection Engine Configuration
MAX_TRENDS_PER_RUN=10
MIN_TREND_SCORE=75
ALLOWED_CATEGORIES=exam-results,admit-cards,exam-dates,government-jobs,higher-education,school-boards,scholarships,career-guides,student-technology
TRENDS_FETCH_TIMEOUT=15

# Session Configuration
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=true
