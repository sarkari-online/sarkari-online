# ==============================================================================
# EduPulse - Apache Configuration & URL Rewrites
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /automation/

    # Security: Deny direct access to sensitive directories and system folders
    RewriteRule ^(\.git|\.env|app|storage|cron|database|scripts|scratch)/ - [F,L,NC]
    RewriteRule ^(config\.php|composer\.(json|lock))$ - [F,L,NC]

    # Block direct access to all sensitive file extensions (.sql, .env, .log, .sh, .lock)
    <FilesMatch "\.(env|sql|log|sh|lock|json|bak|config)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </FilesMatch>

    # Clean URLs for Public Pages
    RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
    RewriteRule ^feed/?$ feed.php [L,QSA]
    RewriteRule ^feed\.xml$ feed.php [L,QSA]
    RewriteRule ^rss\.xml$ feed.php [L,QSA]
    RewriteRule ^rss/?$ feed.php [L,QSA]
    RewriteRule ^pinterest-feed/?$ pinterest-feed.php [L,QSA]
    RewriteRule ^pinterest-feed\.xml$ pinterest-feed.php [L,QSA]
    RewriteRule ^article/([a-zA-Z0-9_-]+)/?$ article.php?slug=$1 [L,QSA]
    RewriteRule ^category/([a-zA-Z0-9_-]+)/?$ category.php?slug=$1 [L,QSA]
    RewriteRule ^search/?$ search.php [L,QSA]
    RewriteRule ^about/?$ about.php [L,QSA]
    RewriteRule ^why-choose-us/?$ why-choose-us.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]
    RewriteRule ^privacy-policy/?$ privacy-policy.php [L,QSA]
    RewriteRule ^disclaimer/?$ disclaimer.php [L,QSA]
    RewriteRule ^terms/?$ terms.php [L,QSA]
    RewriteRule ^editorial-policy/?$ editorial-policy.php [L,QSA]
    RewriteRule ^ai-policy/?$ ai-policy.php [L,QSA]
    RewriteRule ^tools/?$ tools/index.php [L,QSA]
    RewriteRule ^tools/7th-pay-commission-salary-calculator/?$ tools/7th-pay-commission-salary-calculator.php [L,QSA]
    RewriteRule ^tools/salary-calculator/?$ tools/7th-pay-commission-salary-calculator.php [L,QSA]
    RewriteRule ^tools/cgpa-to-percentage-calculator/?$ tools/cgpa-to-percentage-calculator.php [L,QSA]
    RewriteRule ^tools/cgpa-calculator/?$ tools/cgpa-to-percentage-calculator.php [L,QSA]

    # Serve existing files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Custom 404 Fallback
    ErrorDocument 404 /automation/404.php
</IfModule>

# Security Headers & Caching Directives
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Static Assets Long-Lived Cache (1 Year)
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|swf|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
</IfModule>

# Gzip / Deflate Compression (Reduces network payload by up to 80%)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# Browser Caching Policy
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Images & Media
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    
    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # HTML (Fresh updates)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
