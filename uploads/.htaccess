# Block script execution in uploads directory
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|inc|cgi|pl|py|sh|asp|aspx|exe)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -ExecCGI
